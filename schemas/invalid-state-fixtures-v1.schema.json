{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mberlanda/quantik-core-contracts/schemas/invalid-state-fixtures-v1.schema.json",
  "title": "Quantik invalid-state-fixtures.v1 document",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "cases"],
  "properties": {
    "schema": {
      "const": "invalid-state-fixtures.v1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["case_id", "boundary", "expected_rejection", "note"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "boundary": { "enum": ["parser", "constructor"] },
          "expected_rejection": {
            "enum": [
              "MALFORMED_QFEN",
              "TURN_BALANCE_INVALID",
              "SHAPE_COUNT_EXCEEDED",
              "ILLEGAL_PLACEMENT",
              "PIECE_OVERLAP"
            ]
          },
          "note": { "type": "string", "minLength": 1 },
          "qfen": { "type": "string" },
          "bitboards": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        "oneOf": [
          { "required": ["qfen"] },
          { "required": ["bitboards"] }
        ]
      }
    }
  }
}
