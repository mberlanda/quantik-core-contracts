{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mberlanda/quantik-core-contracts/schemas/symmetry-fixtures-v1.schema.json",
  "title": "Quantik symmetry-fixtures.v1 document",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "board_cases", "action_remap_cases"],
  "properties": {
    "schema": {
      "const": "symmetry-fixtures.v1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "board_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "case_id",
          "qfen",
          "canonical_qfen",
          "canonical_key",
          "orbit_size",
          "transforms"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "qfen": { "$ref": "qfen-v1.schema.json" },
          "canonical_qfen": { "$ref": "qfen-v1.schema.json" },
          "canonical_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{36}$"
          },
          "orbit_size": { "type": "integer", "minimum": 1, "maximum": 192 },
          "transforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["transform_index", "d4_index", "shape_perm", "qfen"],
              "properties": {
                "transform_index": { "type": "integer", "minimum": 0, "maximum": 191 },
                "d4_index": { "type": "integer", "minimum": 0, "maximum": 7 },
                "shape_perm": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "integer", "minimum": 0, "maximum": 3 }
                },
                "qfen": { "$ref": "qfen-v1.schema.json" }
              }
            }
          }
        }
      }
    },
    "action_remap_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "case_id",
          "action_index",
          "transform_index",
          "expected_action_index",
          "inverse_transform_index"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "action_index": { "type": "integer", "minimum": 0, "maximum": 63 },
          "transform_index": { "type": "integer", "minimum": 0, "maximum": 191 },
          "expected_action_index": { "type": "integer", "minimum": 0, "maximum": 63 },
          "inverse_transform_index": { "type": "integer", "minimum": 0, "maximum": 191 }
        }
      }
    }
  }
}
